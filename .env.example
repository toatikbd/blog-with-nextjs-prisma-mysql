# Copy to .env and fill in the values.
DATABASE_URL="mysql://root:password@localhost:3306/blog_with_prisma"

AUTH_SECRET=""            # npx auth secret
AUTH_TRUST_HOST="true"    # the app runs behind Nginx on the VPS

UPLOAD_DIR="./uploads"
UPLOAD_MAX_MB="5"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Used only by `npx prisma db seed` to create the first admin
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
